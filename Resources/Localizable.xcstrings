          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So könnte dein Tag aussehen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ejemplo de tu día"
          }
        }
      }
    },
    "Conta i progressi. Trova il tuo momento.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta i progressi. Trova il tuo momento."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track your progress. Find your moment."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez vos progrès. Trouvez votre moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zähle deine Fortschritte. Finde deinen Moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra tu progreso. Encuentra tu momento."
          }
        }
      }
    },
    "Con un account li ritrovi anche su un nuovo dispositivo. Oppure puoi iniziare solo qui.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un account li ritrovi anche su un nuovo dispositivo. Oppure puoi iniziare solo qui."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An account keeps your progress with you, even on a new device. Or you can start just here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un compte, retrouvez vos progrès même sur un nouvel appareil. Ou commencez simplement ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem Konto bleiben deine Fortschritte auch auf einem neuen Gerät bei dir. Oder du startest nur hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una cuenta, conservas tu progreso incluso en un dispositivo nuevo. O puedes empezar solo aquí."
          }
        }
      }
    },
    "Il tuo archivio privato, sincronizzato con Makeet Plus. Accedi con Apple o Google.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo archivio privato, sincronizzato con Makeet Plus. Accedi con Apple o Google."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your private archive, synced with Makeet Plus. Sign in with Apple or Google."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre archive privée, synchronisée avec Makeet Plus. Connectez-vous avec Apple ou Google."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein privates Archiv, synchronisiert mit Makeet Plus. Melde dich mit Apple oder Google an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu archivo privado, sincronizado con Makeet Plus. Entra con Apple o Google."
          }
        }
      }
    },
    "Nessuna registrazione. I progressi restano qui: potrai accedere quando vuoi.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna registrazione. I progressi restano qui: potrai accedere quando vuoi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No sign-up. Your progress stays here. You can sign in whenever you like."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans inscription. Vos progrès restent ici. Vous pourrez vous connecter quand vous voulez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Registrierung. Deine Fortschritte bleiben hier. Du kannst dich jederzeit anmelden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin registro. Tu progreso se queda aquí. Puedes iniciar sesión cuando quieras."
          }
        }
      }
    },
    "Senza account, rimuovere l’app o perdere il dispositivo può far perdere i progressi.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza account, rimuovere l’app o perdere il dispositivo può far perdere i progressi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without an account, deleting the app or losing your device can mean losing your progress."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans compte, supprimer l’app ou perdre votre appareil peut entraîner la perte de vos progrès."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Konto können deine Fortschritte verloren gehen, wenn du die App löschst oder dein Gerät verlierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta, borrar la app o perder el dispositivo puede suponer perder tu progreso."
          }
        }
      }
    },
    "La scelta è tua. Calendario e notifiche si attivano solo quando vuoi.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scelta è tua. Calendario e notifiche si attivano solo quando vuoi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It’s your choice. Connect your calendar and notifications when you’re ready."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À vous de choisir. Activez le calendrier et les notifications quand vous voulez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du entscheidest. Kalender und Mitteilungen aktivierst du, wenn du möchtest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú eliges. Activa el calendario y las notificaciones cuando quieras."
          }
        }
      }
    },
    "È il tuo primo accesso? Creiamo il tuo account. Sei già dei nostri? Ritrovi i tuoi progressi.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È il tuo primo accesso? Creiamo il tuo account. Sei già dei nostri? Ritrovi i tuoi progressi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New here? We’ll create your account. Coming back? Pick up where you left off."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Première visite ? Nous créons votre compte. Déjà inscrit ? Retrouvez vos progrès."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neu hier? Wir erstellen dein Konto. Schon dabei? Mach mit deinen Fortschritten weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Es tu primera vez? Creamos tu cuenta. ¿Ya tienes una? Recupera tu progreso."
          }
        }
      }
    },
    "Nessuna nuova password. Nessun profilo pubblico.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna nuova password. Nessun profilo pubblico."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No new password. No public profile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de nouveau mot de passe. Pas de profil public."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein neues Passwort. Kein öffentliches Profil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin nueva contraseña. Sin perfil público."
          }
        }
      }
    },
    "Hai già abitudini sul dispositivo? Dopo l’accesso decidi tu se importarle.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai già abitudini sul dispositivo? Dopo l’accesso decidi tu se importarle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already have habits on this device? You decide whether to import them after signing in."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez déjà des habitudes sur cet appareil ? Après la connexion, vous choisissez de les importer ou non."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schon Gewohnheiten auf diesem Gerät? Nach der Anmeldung entscheidest du, ob du sie importierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ya tienes hábitos en este dispositivo? Después de entrar decides si quieres importarlos."
          }
        }
      }
    },
    "Aggiungi il tuo tocco": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi il tuo tocco"
