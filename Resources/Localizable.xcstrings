    "I tuoi progressi sono salvati su questo dispositivo. Il collegamento iCloud e l’accesso diretto a Google saranno disponibili in una prossima versione.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi progressi sono salvati su questo dispositivo. Il collegamento iCloud e l’accesso diretto a Google saranno disponibili in una prossima versione."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your progress is saved on this device. iCloud and direct Google access will be available in a future version."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos progrès sont enregistrés sur cet appareil. La connexion iCloud et l’accès direct à Google seront disponibles dans une prochaine version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Fortschritt wird auf diesem Gerät gespeichert. iCloud und der direkte Google-Zugriff folgen in einer späteren Version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus avances se guardan en este dispositivo. La conexión con iCloud y el acceso directo a Google estarán disponibles en una próxima versión."
          }
        }
      }
    },
