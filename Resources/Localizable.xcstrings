            "value": "Zum Synchronisieren anmelden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión para sincronizar"
          }
        }
      }
    },
    "Scegli Apple o Google. Usiamo l’identità e l’email fornite per creare il tuo account privato Makeet.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli Apple o Google. Usiamo l’identità e l’email fornite per creare il tuo account privato Makeet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Apple or Google. We use the identity and email provided to create your private Makeet account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez Apple ou Google. L’identité et l’email fournis servent à créer votre compte privé Makeet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Apple oder Google. Wir nutzen die übermittelte Identität und E-Mail-Adresse für dein privates Makeet-Konto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige Apple o Google. Usamos la identidad y el correo facilitados para crear tu cuenta privada Makeet."
          }
        }
      }
    },
    "Preferisco continuare senza account": {
      "localizations": {
        "it": {
          "stringUnit": {
