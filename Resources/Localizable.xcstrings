    "Oggi puoi riposare": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi puoi riposare"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can rest today"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd’hui, vous pouvez souffler"
          }
        },
