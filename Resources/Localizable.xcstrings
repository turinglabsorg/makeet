    "I promemoria sono facoltativi e non contengono nomi o dati delle abitudini. La ricezione viene confermata quando l’app vede o apri la notifica.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria sono facoltativi e non contengono nomi o dati delle abitudini. La ricezione viene confermata quando l’app vede o apri la notifica."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders are optional and contain no habit names or data. Receipt is confirmed when the app sees the notification or you open it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels sont facultatifs et ne contiennent aucun nom ni donnée d’habitude. La réception est confirmée lorsque l’app voit la notification ou que vous l’ouvrez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen sind freiwillig und enthalten keine Namen oder Daten deiner Gewohnheiten. Der Empfang wird bestätigt, wenn die App die Mitteilung sieht oder du sie öffnest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios son opcionales y no contienen nombres ni datos de hábitos. La recepción se confirma cuando la app ve la notificación o la abres."
          }
        }
      }
    },
