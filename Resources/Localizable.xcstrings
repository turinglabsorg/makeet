    "Guarda oltre la serie di giorni. Conta anche quanto fai, con quale frequenza e quando.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda oltre la serie di giorni. Conta anche quanto fai, con quale frequenza e quando."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look beyond your streak. How much, how often, and when matter too."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regardez au-delà de la série de jours. La quantité, la fréquence et le moment comptent aussi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau über deine Serie hinaus. Auch Menge, Häufigkeit und Zeitpunkt zählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira más allá de la racha. También cuentan la cantidad, la frecuencia y el momento."
          }
        }
      }
    },
    "Hai raggiunto gli obiettivi oppure non resta uno spazio sufficiente tra le 7 e le 22. Puoi comunque registrare attività in Oggi.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai raggiunto gli obiettivi oppure non resta uno spazio sufficiente tra le 7 e le 22. Puoi comunque registrare attività in Oggi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ve met your targets or there’s no suitable slot left between 7 am and 10 pm. You can still log activity in Today."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez atteint vos objectifs ou il ne reste aucun créneau suffisant entre 7 h et 22 h. Vous pouvez toujours enregistrer des activités dans Aujourd’hui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast deine Ziele erreicht oder zwischen 7 und 22 Uhr ist kein passendes Zeitfenster mehr frei. Unter Heute kannst du weiterhin Aktivitäten erfassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has alcanzado tus objetivos o ya no queda un hueco suficiente entre las 7 y las 22. Puedes seguir registrando actividad en Hoy."
          }
        }
      }
    },
