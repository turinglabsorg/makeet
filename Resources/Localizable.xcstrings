        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kauf ist mit einem anderen Makeet-Konto verknüpft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compra está vinculada a otra cuenta de Makeet."
          }
        }
      }
    },
    "Acquisto o verifica non completati. I progressi restano disponibili; puoi riprovare o ripristinare gli acquisti.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquisto o verifica non completati. I progressi restano disponibili; puoi riprovare o ripristinare gli acquisti."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchase or verification did not complete. Your progress remains available; retry or restore purchases."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’achat ou la vérification n’a pas abouti. Vos progrès restent disponibles ; réessayez ou restaurez les achats."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kauf oder Prüfung nicht abgeschlossen. Deine Fortschritte bleiben verfügbar; versuche es erneut oder stelle Käufe wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra o verificación no se completó. Tus progresos siguen disponibles; reintenta o restaura las compras."
          }
        }
      }
    },
    "Abitudini, statistiche e pianificazione sul dispositivo sono gratis. Plus aggiunge la sincronizzazione privata tra i tuoi dispositivi.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abitudini, statistiche e pianificazione sul dispositivo sono gratis. Plus aggiunge la sincronizzazione privata tra i tuoi dispositivi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Habits, statistics and planning on your device are free. Plus adds private sync across your devices."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les habitudes, les statistiques et la planification sur votre appareil sont gratuites. Plus ajoute la synchronisation privée entre vos appareils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewohnheiten, Statistiken und Planung auf deinem Gerät sind kostenlos. Plus ergänzt die private Synchronisierung zwischen deinen Geräten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los hábitos, las estadísticas y la planificación en tu dispositivo son gratis. Plus añade la sincronización privada entre tus dispositivos."
          }
        }
      }
    },
    "Makeet Plus è attivo": {
