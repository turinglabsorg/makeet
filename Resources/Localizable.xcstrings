    "Tutti i giorni scelti sono già pianificati, completati o senza spazi liberi tra le 7 e le 22. Puoi cambiare periodo o preferenze.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i giorni scelti sono già pianificati, completati o senza spazi liberi tra le 7 e le 22. Puoi cambiare periodo o preferenze."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All selected days are already planned, completed, or have no free time between 7 AM and 10 PM. You can change the period or preferences."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les jours choisis sont déjà planifiés, terminés ou sans créneau libre entre 7 h et 22 h. Vous pouvez changer la période ou les préférences."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle gewählten Tage sind bereits geplant, abgeschlossen oder haben keinen freien Platz zwischen 7 und 22 Uhr. Du kannst Zeitraum oder Einstellungen ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los días elegidos están planificados, completados o sin huecos libres entre las 7 y las 22. Puedes cambiar el período o las preferencias."
          }
        }
      }
    },
