    "Usa da 15 a 128 caratteri. Puoi usare una frase con spazi.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa da 15 a 128 caratteri. Puoi usare una frase con spazi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 15–128 characters. A phrase with spaces is welcome."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez 15 à 128 caractères. Une phrase avec des espaces convient."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende 15–128 Zeichen. Ein Satz mit Leerzeichen ist möglich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa entre 15 y 128 caracteres. Puedes usar una frase con espacios."
          }
        }
      }
    },
    "Da 3 a 32 caratteri: lettere senza accenti, numeri, punto, trattino o trattino basso.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da 3 a 32 caratteri: lettere senza accenti, numeri, punto, trattino o trattino basso."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3–32 characters: unaccented letters, numbers, dot, hyphen or underscore."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "3 à 32 caractères : lettres sans accent, chiffres, point, tiret ou trait de soulignement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3–32 Zeichen: Buchstaben ohne Akzente, Zahlen, Punkt, Bindestrich oder Unterstrich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De 3 a 32 caracteres: letras sin acento, números, punto, guion o guion bajo."
          }
        }
      }
    },
    "Se la richiesta è valida, riceverai un codice via email. Scade tra 15 minuti. Controlla anche lo spam.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se la richiesta è valida, riceverai un codice via email. Scade tra 15 minuti. Controlla anche lo spam."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the request is valid, you’ll receive an email code. It expires in 15 minutes. Check spam too."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la demande est valide, vous recevrez un code par email. Il expire dans 15 minutes. Vérifiez aussi les indésirables."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die Anfrage gültig ist, erhältst du einen Code per E-Mail. Er läuft in 15 Minuten ab. Prüfe auch den Spamordner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la solicitud es válida, recibirás un código por correo. Caduca en 15 minutos. Revisa también el correo no deseado."
          }
        }
      }
    },
    "Credenziali salvate. Puoi usarle anche sull’altro dispositivo.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Credenziali salvate. Puoi usarle anche sull’altro dispositivo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Credentials saved. You can use them on your other device too."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifiants enregistrés. Vous pouvez aussi les utiliser sur votre autre appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugangsdaten gespeichert. Du kannst sie auch auf deinem anderen Gerät verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Credenciales guardadas. También puedes usarlas en tu otro dispositivo."
          }
        }
      }
    },
    "Per cambiare la password, esci e scegli Password dimenticata. Le vecchie sessioni verranno disconnesse.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per cambiare la password, esci e scegli Password dimenticata. Le vecchie sessioni verranno disconnesse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To change your password, sign out and choose Forgot password. Your old sessions will be signed out."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour modifier le mot de passe, déconnectez-vous et choisissez Mot de passe oublié. Vos anciennes sessions seront déconnectées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dein Passwort zu ändern, melde dich ab und wähle Passwort vergessen. Deine bisherigen Sitzungen werden abgemeldet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cambiar la contraseña, cierra sesión y elige He olvidado mi contraseña. Se cerrarán tus sesiones anteriores."
          }
        }
      }
    },
    "Troppi tentativi. Attendi e riprova.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppi tentativi. Attendi e riprova."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. Wait and try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de tentatives. Patientez et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Versuche. Warte und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos. Espera y vuelve a intentarlo."
          }
        }
      }
    },
    "Accesso con password temporaneamente non disponibile. Riprova più tardi.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso con password temporaneamente non disponibile. Riprova più tardi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password access is temporarily unavailable. Try again later."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion par mot de passe est temporairement indisponible. Réessayez plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung mit Passwort ist vorübergehend nicht verfügbar. Versuche es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso con contraseña no está disponible temporalmente. Inténtalo más tarde."
          }
        }
      }
    },
    "Controlla i dati o il codice e riprova. Il tuo archivio è conservato.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla i dati o il codice e riprova. Il tuo archivio è conservato."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your details or code and try again. Your archive is retained."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez vos informations ou le code et réessayez. Votre archive est conservée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe deine Angaben oder den Code und versuche es erneut. Dein Archiv bleibt erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba tus datos o el código y vuelve a intentarlo. Tu archivo se conserva."
          }
        }
      }
    },
    "Il tuo account e i tuoi progressi restano privati.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account e i tuoi progressi restano privati."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account and progress stay private."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte et vos progrès restent privés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto und deine Fortschritte bleiben privat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta y tus avances siguen siendo privados."
          }
        }
      }
    },
    "Il tuo archivio privato, sincronizzato gratuitamente. Scegli come accedere.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo archivio privato, sincronizzato gratuitamente. Scegli come accedere."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your private archive, synced for free. Choose how to sign in."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre archive privée, synchronisée gratuitement. Choisissez comment vous connecter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein privates Archiv, kostenlos synchronisiert. Wähle, wie du dich anmeldest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu archivo privado, sincronizado gratis. Elige cómo acceder."
          }
        }
      }
    },
    "Hai già un account? Aggiungi le credenziali da Account sul dispositivo dove hai già effettuato l’accesso per conservare i tuoi progressi.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai già un account? Aggiungi le credenziali da Account sul dispositivo dove hai già effettuato l’accesso per conservare i tuoi progressi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already have an account? Add credentials in Account on the device where you are signed in to keep your progress."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez déjà un compte ? Ajoutez des identifiants dans Compte sur l’appareil où vous êtes connecté pour conserver vos progrès."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast bereits ein Konto? Füge unter Konto auf dem Gerät, auf dem du angemeldet bist, Zugangsdaten hinzu, um deine Fortschritte zu behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ya tienes una cuenta? Añade credenciales en Cuenta en el dispositivo donde has iniciado sesión para conservar tus avances."
          }
        }
      }
    }
  },
  "version": "1.0"
}
