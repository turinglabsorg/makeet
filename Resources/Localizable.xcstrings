    "Scegli un limite, anche zero. Le quantità oltre il limite contano come malus. Conferma zero per registrare un giorno senza occorrenze.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Grenzwert, auch null. Mengen darüber zählen als Malus. Bestätige null, um einen Tag ohne Vorkommnisse zu erfassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a limit, including zero. Quantities above the limit count as a penalty. Confirm zero to record a day with no occurrences."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un límite, incluso cero. Las cantidades superiores cuentan como penalización. Confirma cero para registrar un día sin ocurrencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une limite, même zéro. Les quantités au-delà comptent comme malus. Confirmez zéro pour enregistrer une journée sans occurrence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un limite, anche zero. Le quantità oltre il limite contano come malus. Conferma zero per registrare un giorno senza occorrenze."
          }
        }
      }
    },
