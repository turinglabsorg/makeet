    "Collega il calendario per trovare spazi liberi. Senza accesso, gli orari sono indicativi e potrebbero sovrapporsi ai tuoi impegni.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega il calendario per trovare spazi liberi. Senza accesso, gli orari sono indicativi e potrebbero sovrapporsi ai tuoi impegni."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your calendar to find free slots. Without access, suggested times may overlap with your commitments."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez votre calendrier pour trouver des créneaux libres. Sans accès, les horaires sont indicatifs et peuvent chevaucher vos engagements."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde deinen Kalender, um freie Zeiten zu finden. Ohne Zugriff sind die Zeiten unverbindlich und können mit Terminen kollidieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta el calendario para encontrar huecos libres. Sin acceso, los horarios son orientativos y pueden coincidir con tus compromisos."
          }
        }
      }
    },
