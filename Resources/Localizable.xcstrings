          }
        }
      }
    },
    "Anche se Plus scade, i dati già presenti restano consultabili, modificabili ed esportabili. Account e cancellazione restano sempre accessibili.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche se Plus scade, i dati già presenti restano consultabili, modificabili ed esportabili. Account e cancellazione restano sempre accessibili."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even if Plus expires, existing data remains available to view, edit and export. Account access and deletion are always available."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même si Plus expire, les données présentes restent consultables, modifiables et exportables. L’accès au compte et la suppression restent disponibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch nach Ablauf von Plus kannst du vorhandene Daten ansehen, bearbeiten und exportieren. Kontozugriff und Löschung bleiben immer verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aunque Plus caduque, puedes consultar, editar y exportar tus datos existentes. El acceso a la cuenta y la eliminación siempre están disponibles."
          }
        }
      }
    },
    "La sincronizzazione richiede Makeet Plus. I dati già presenti restano sul dispositivo.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione richiede Makeet Plus. I dati già presenti restano sul dispositivo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync requires Makeet Plus. Existing data remains on your device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation nécessite Makeet Plus. Les données présentes restent sur votre appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisierung erfordert Makeet Plus. Vorhandene Daten bleiben auf deinem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización requiere Makeet Plus. Los datos existentes permanecen en tu dispositivo."
          }
        }
      }
    },
    "Esporta i tuoi dati": {
      "localizations": {
