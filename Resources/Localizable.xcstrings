    "Rimuove solo gli eventi futuri collegati a questa abitudine nei calendari modificabili. Gli altri eventi restano al loro posto.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove solo gli eventi futuri collegati a questa abitudine nei calendari modificabili. Gli altri eventi restano al loro posto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes only future events linked to this habit in editable calendars. Other events stay in place."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime uniquement les événements futurs liés à cette habitude dans les calendriers modifiables. Les autres événements sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
