    "%lld giorni a obiettivo su %lld osservati. I giorni precedenti alla creazione sono esclusi.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld giorni a obiettivo su %lld osservati. I giorni precedenti alla creazione sono esclusi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Target reached on %lld of %lld observed days. Days before creation are excluded."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Objectif atteint sur %lld des %lld jours observés. Les jours précédant la création sont exclus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziel an %lld von %lld erfassten Tagen erreicht. Tage vor der Erstellung werden nicht berücksichtigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Objetivo alcanzado en %lld de %lld días observados. Se excluyen los días anteriores a la creación."
          }
        }
      }
    },
