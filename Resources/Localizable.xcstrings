    "Scegli tu quando consentire le notifiche. L’invio dei promemoria richiede anche il collegamento al servizio Makeet, ancora in configurazione.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli tu quando consentire le notifiche. L’invio dei promemoria richiede anche il collegamento al servizio Makeet, ancora in configurazione."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You choose when to allow notifications. Reminders also require a connection to the Makeet service, which is still being configured."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous choisissez quand autoriser les notifications. Les rappels nécessitent aussi une connexion au service Makeet, encore en cours de configuration."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du entscheidest, wann du Mitteilungen erlaubst. Erinnerungen benötigen außerdem den Makeet-Dienst, der noch eingerichtet wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú eliges cuándo permitir las notificaciones. Los recordatorios también requieren conexión al servicio Makeet, que aún se está configurando."
          }
        }
      }
    },
