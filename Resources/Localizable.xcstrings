    "Aggiunge la quantità scelta all’abitudine, senza aprire Makeet.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge la quantità scelta all’abitudine, senza aprire Makeet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds the chosen amount to your habit without opening Makeet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute la quantité choisie à l’habitude sans ouvrir Makeet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt der Gewohnheit die gewählte Menge hinzu, ohne Makeet zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade la cantidad elegida al hábito sin abrir Makeet."
          }
        }
      }
    },
