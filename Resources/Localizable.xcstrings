    "Elimineremo definitivamente l’abitudine e tutte le sue registrazioni. Questa operazione non si può annullare.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimineremo definitivamente l’abitudine e tutte le sue registrazioni. Questa operazione non si può annullare."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes the habit and all its entries. This cannot be undone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’habitude et toutes ses saisies seront définitivement supprimées. Cette opération est irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gewohnheit und alle ihre Einträge werden dauerhaft gelöscht. Das kann nicht rückgängig gemacht werden."
