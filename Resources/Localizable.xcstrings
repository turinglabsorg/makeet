    "Il piano annuale addebita l’intero importo ogni anno. L’abbonamento si rinnova automaticamente; puoi annullarlo nelle impostazioni dell’App Store.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il piano annuale addebita l’intero importo ogni anno. L’abbonamento si rinnova automaticamente; puoi annullarlo nelle impostazioni dell’App Store."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The yearly plan charges the full amount each year. Subscriptions renew automatically; cancel in your App Store settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le forfait annuel facture le montant total chaque année. L’abonnement se renouvelle automatiquement ; annulez dans les réglages de l’App Store."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Jahresplan berechnet den Gesamtbetrag jedes Jahr. Das Abonnement verlängert sich automatisch; kündige in den App-Store-Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan anual cobra el importe completo cada año. La suscripción se renueva automáticamente; cancélala en los ajustes del App Store."
          }
        }
      }
    },
    "Ripristina acquisti": {
