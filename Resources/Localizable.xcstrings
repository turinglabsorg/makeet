    "Le modifiche a obiettivo e giorni si applicano anche alle statistiche passate. Le quantità registrate restano invariate.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche a obiettivo e giorni si applicano anche alle statistiche passate. Le quantità registrate restano invariate."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes to targets and weekdays also apply to past statistics. Recorded quantities stay unchanged."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les changements d’objectif et de jours s’appliquent aussi aux statistiques passées. Les quantités enregistrées restent inchangées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen an Ziel und Wochentagen gelten auch für frühere Statistiken. Erfasste Mengen bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios de objetivo y días también se aplican a las estadísticas pasadas. Las cantidades registradas no cambian."
          }
        }
      }
    },
