    "Aggiungi la tua prima abitudine in Oggi. Poi le cerchiamo un posto nella giornata.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi la tua prima abitudine in Oggi. Poi le cerchiamo un posto nella giornata."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your first habit in Today. Then we’ll find room for it in your day."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez votre première habitude dans Aujourd’hui. Nous lui trouverons ensuite une place dans la journée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege unter Heute deine erste Gewohnheit an. Dann suchen wir einen Platz dafür in deinem Tag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tu primer hábito en Hoy. Después le buscaremos un hueco en el día."
          }
        }
      }
    },
