    "Lo storico è conservato. Puoi ripristinarla dall’archivio in Oggi.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo storico è conservato. Puoi ripristinarla dall’archivio in Oggi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your history is preserved. Restore this habit from the archive in Today."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique est conservé. Restaurez cette habitude depuis les archives dans Aujourd’hui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf bleibt erhalten. Stelle diese Gewohnheit im Archiv unter Heute wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial se conserva. Puedes restaurar este hábito desde el archivo en Hoy."
          }
        }
      }
    },
    "L’assistente userà queste preferenze per proporti uno spazio libero. Nessun evento viene creato automaticamente.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’assistente userà queste preferenze per proporti uno spazio libero. Nessun evento viene creato automaticamente."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assistant uses these preferences to suggest a free slot. No event is created automatically."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’assistant utilise ces préférences pour proposer un créneau libre. Aucun événement n’est créé automatiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
