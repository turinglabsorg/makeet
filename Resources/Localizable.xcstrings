    "Ogni account ha un archivio separato. Accedere non carica automaticamente i dati locali o dimostrativi.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni account ha un archivio separato. Accedere non carica automaticamente i dati locali o dimostrativi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each account has a separate archive. Signing in never uploads local or demo data automatically."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque compte possède une archive distincte. La connexion ne transfère pas automatiquement les données locales ou de démonstration."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Konto hat ein eigenes Archiv. Bei der Anmeldung werden lokale Daten und Beispieldaten nicht automatisch hochgeladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada cuenta tiene un archivo separado. Iniciar sesión no sube automáticamente los datos locales ni de demostración."
          }
        }
      }
    },
