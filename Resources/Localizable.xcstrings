          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With negative values enabled, minus can take your balance below zero. History preserves the sign of each quantity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con valores negativos activados, menos puede llevar el saldo por debajo de cero. El historial conserva el signo de las cantidades."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec les valeurs négatives, le bouton moins peut faire passer le solde sous zéro. L’historique conserve le signe des quantités."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con i valori negativi attivi, il pulsante meno può portare il saldo sotto zero. Lo storico mantiene il segno delle quantità."
          }
        }
      }
    },
