    "Un passo, poi un altro.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un passo, poi un altro."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One step, then another."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pas, puis un autre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Schritt, dann der nächste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paso, luego otro."
          }
        }
      }
    },
    "Fai spazio alle abitudini che contano per te. Makeet ti aiuta a registrare quanto fai e a trovare il momento giusto.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai spazio alle abitudini che contano per te. Makeet ti aiuta a registrare quanto fai e a trovare il momento giusto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make room for the habits that matter to you. Makeet helps you record how much you do and find the right time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites place aux habitudes qui comptent. Makeet vous aide à noter ce que vous faites et à trouver le bon moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaffe Raum für wichtige Gewohnheiten. Makeet hilft dir, Mengen zu erfassen und den passenden Zeitpunkt zu finden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz espacio para los hábitos que te importan. Makeet te ayuda a registrar cuánto haces y encontrar el momento adecuado."
          }
        }
      }
    },
    "Conta ogni piccolo passo": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta ogni piccolo passo"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Count every small step"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comptez chaque petit pas"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder kleine Schritt zählt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta cada pequeño paso"
          }
        }
      }
    },
    "Bicchieri, pagine, minuti: aggiungi le quantità e correggile quando serve.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bicchieri, pagine, minuti: aggiungi le quantità e correggile quando serve."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasses, pages, minutes: add quantities and correct them when needed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verres, pages, minutes : ajoutez les quantités et corrigez-les au besoin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gläser, Seiten, Minuten: Ergänze Mengen und korrigiere sie bei Bedarf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vasos, páginas, minutos: añade cantidades y corrígelas cuando haga falta."
          }
        }
      }
    },
    "Capisci il tuo andamento": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capisci il tuo andamento"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Understand your progress"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprenez vos progrès"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstehe deinen Fortschritt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entiende tu progreso"
          }
        }
      }
    },
    "Ritrova progressi, costanza e orari in cui le abitudini funzionano meglio.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritrova progressi, costanza e orari in cui le abitudini funzionano meglio."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See your progress, consistency and the times that work best for your habits."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrouvez vos progrès, votre régularité et les moments qui conviennent à vos habitudes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkenne Fortschritt, Regelmäßigkeit und passende Zeiten für deine Gewohnheiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa tu progreso, constancia y las horas que mejor encajan con tus hábitos."
          }
        }
      }
    },
    "Un piano che lascia spazio": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un piano che lascia spazio"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A plan with room to breathe"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programme qui laisse de la place"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Plan mit Freiraum"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un plan que deja espacio"
          }
        }
      }
    },
    "Collega il calendario quando vuoi. Ogni nuovo evento richiede la tua conferma.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega il calendario quando vuoi. Ogni nuovo evento richiede la tua conferma."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your calendar when you want. Every new event needs your confirmation."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez votre calendrier quand vous le souhaitez. Chaque nouvel événement demande votre confirmation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde deinen Kalender, wann du möchtest. Jeder neue Termin benötigt deine Bestätigung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta el calendario cuando quieras. Cada evento nuevo necesita tu confirmación."
          }
        }
      }
    },
    "Dove teniamo i tuoi progressi?": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove teniamo i tuoi progressi?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where should your progress live?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où conserver vos progrès ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo bleiben deine Fortschritte?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Dónde guardamos tu progreso?"
          }
        }
      }
    },
    "Puoi scegliere adesso e accedere anche in seguito.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi scegliere adesso e accedere anche in seguito."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose now. You can also sign in later."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez maintenant. Vous pourrez aussi vous connecter plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle jetzt. Du kannst dich auch später anmelden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige ahora. También puedes iniciar sesión más adelante."
          }
        }
      }
    },
    "Con un account": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un account"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With an account"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un compte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem Konto"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una cuenta"
          }
        }
      }
    },
    "Salva i progressi nel tuo account Makeet e sincronizzali tra i tuoi dispositivi. L’accesso usa Apple o Google, senza una nuova password.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva i progressi nel tuo account Makeet e sincronizzali tra i tuoi dispositivi. L’accesso usa Apple o Google, senza una nuova password."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save progress in your Makeet account and sync it across your devices. Sign in with Apple or Google, without a new password."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez vos progrès dans votre compte Makeet et synchronisez vos appareils. Connectez-vous avec Apple ou Google, sans nouveau mot de passe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere Fortschritte im Makeet-Konto und synchronisiere deine Geräte. Anmeldung mit Apple oder Google, ohne neues Passwort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el progreso en tu cuenta Makeet y sincronízalo entre dispositivos. Accede con Apple o Google, sin una contraseña nueva."
          }
        }
      }
    },
    "Solo su questo dispositivo": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo su questo dispositivo"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only on this device"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement sur cet appareil"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur auf diesem Gerät"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo en este dispositivo"
          }
        }
      }
    },
    "Inizia senza registrarti. Le abitudini restano nell’archivio locale e non vengono caricate nel servizio Makeet. Non si sincronizzano con altri dispositivi.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia senza registrarti. Le abitudini restano nell’archivio locale e non vengono caricate nel servizio Makeet. Non si sincronizzano con altri dispositivi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start without registering. Habits stay in the local archive and are not uploaded to Makeet. They do not sync to other devices."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez sans inscription. Les habitudes restent dans l’archive locale, sans envoi au service Makeet ni synchronisation avec d’autres appareils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte ohne Registrierung. Gewohnheiten bleiben im lokalen Archiv und werden nicht an Makeet übertragen. Sie werden nicht mit anderen Geräten synchronisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza sin registrarte. Los hábitos permanecen en el archivo local y no se suben a Makeet. No se sincronizan con otros dispositivos."
          }
        }
      }
    },
    "Se hai già progressi locali, sceglierai tu se importarli dopo l’accesso. Non carichiamo dati dimostrativi.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hai già progressi locali, sceglierai tu se importarli dopo l’accesso. Non carichiamo dati dimostrativi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you already have local progress, you choose whether to import it after signing in. We do not upload demo data."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous avez déjà des progrès locaux, vous choisirez de les importer ou non après connexion. Les données de démonstration ne sont pas envoyées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorhandene lokale Fortschritte importierst du nach der Anmeldung nur auf Wunsch. Demodaten werden nicht übertragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ya tienes progreso local, elegirás si importarlo después de iniciar sesión. No subimos datos de demostración."
          }
        }
      }
    },
    "Puoi passare a un account dalle impostazioni. Proteggi l’archivio locale: rimuovere l’app o perdere il dispositivo può causare la perdita dei progressi.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi passare a un account dalle impostazioni. Proteggi l’archivio locale: rimuovere l’app o perdere il dispositivo può causare la perdita dei progressi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can switch to an account in settings. Protect your local archive: removing the app or losing the device may cause progress to be lost."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pourrez passer à un compte dans les réglages. Protégez l’archive locale : supprimer l’app ou perdre l’appareil peut faire perdre vos progrès."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den Einstellungen kannst du ein Konto nutzen. Schütze dein lokales Archiv: App-Löschung oder Geräteverlust können zum Verlust deiner Fortschritte führen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes pasar a una cuenta en ajustes. Protege el archivo local: eliminar la app o perder el dispositivo puede causar la pérdida del progreso."
          }
        }
      }
    },
    "Calendario e notifiche restano facoltativi. Li attivi in seguito, con il tuo permesso.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendario e notifiche restano facoltativi. Li attivi in seguito, con il tuo permesso."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar and notifications are optional. Enable them later, with your permission."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendrier et notifications restent facultatifs. Activez-les plus tard avec votre autorisation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalender und Mitteilungen bleiben freiwillig. Aktiviere sie später mit deiner Erlaubnis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendario y notificaciones son opcionales. Actívalos más adelante con tu permiso."
          }
        }
      }
    },
    "Continua con un account": {
      "localizations": {
