    "Accedi con Apple o Google per collegare Plus al tuo account. Puoi continuare a usare tutte le funzioni locali senza registrarti.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi con Apple o Google per collegare Plus al tuo account. Puoi continuare a usare tutte le funzioni locali senza registrarti."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with Apple or Google to link Plus to your account. You can keep using all local features without registering."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec Apple ou Google pour associer Plus à votre compte. Toutes les fonctions locales restent disponibles sans inscription."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich mit Apple oder Google an, um Plus mit deinem Konto zu verknüpfen. Alle lokalen Funktionen kannst du weiterhin ohne Registrierung nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión con Apple o Google para vincular Plus a tu cuenta. Puedes seguir usando todas las funciones locales sin registrarte."
          }
        }
      }
    },
    "Gestisci abbonamento": {
