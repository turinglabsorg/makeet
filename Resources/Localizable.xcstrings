    "All’orario scelto, un promemoria se sul servizio risulta almeno un’abitudine da completare. Usa il fuso orario di questo dispositivo.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "All’orario scelto, un promemoria se sul servizio risulta almeno un’abitudine da completare. Usa il fuso orario di questo dispositivo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At your chosen time, a reminder if at least one habit is unfinished on the service. Uses this device’s time zone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l’heure choisie, un rappel si au moins une habitude reste à compléter sur le service. Utilise le fuseau horaire de cet appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zur gewählten Zeit eine Erinnerung, wenn im Dienst noch eine Gewohnheit offen ist. Es gilt die Zeitzone dieses Geräts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A la hora elegida, un recordatorio si queda algún hábito por completar en el servicio. Usa la zona horaria de este dispositivo."
          }
        }
      }
    },
