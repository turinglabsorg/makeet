    "Gli accessi Apple e Google saranno attivati al completamento della configurazione del servizio.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli accessi Apple e Google saranno attivati al completamento della configurazione del servizio."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple and Google sign-in will be enabled when service setup is complete."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion Apple et Google sera activée une fois la configuration du service terminée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung mit Apple und Google wird nach Abschluss der Einrichtung aktiviert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso con Apple y Google se activará cuando termine la configuración del servicio."
          }
        }
      }
    },
