    "Elimineremo definitivamente l’account e i dati dal servizio. Questa azione non può essere annullata.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto und deine Daten werden dauerhaft aus dem Dienst gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account and data will be permanently deleted from the service. This action cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta y tus datos se eliminarán definitivamente del servicio. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte et vos données seront définitivement supprimés du service. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimineremo definitivamente l’account e i dati dal servizio. Questa azione non può essere annullata."
          }
        }
      }
    },
