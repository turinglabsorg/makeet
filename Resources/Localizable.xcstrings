    "Scegli la prima abitudine e quanto vuoi fare. Puoi cambiare tutto, un passo alla volta.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la prima abitudine e quanto vuoi fare. Puoi cambiare tutto, un passo alla volta."
          }
        },
