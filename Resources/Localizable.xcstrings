    "Account eliminato dal servizio. La pulizia dell’archivio su questo dispositivo richiede un nuovo avvio.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Account eliminato dal servizio. La pulizia dell’archivio su questo dispositivo richiede un nuovo avvio."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account was deleted from the service. Restart the app to finish clearing this device’s archive."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte a été supprimé du service. Relancez l’app pour terminer le nettoyage de l’archive sur cet appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto wurde beim Dienst gelöscht. Starte die App neu, um das Archiv auf diesem Gerät vollständig zu leeren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta se eliminó del servicio. Reinicia la app para terminar de limpiar el archivo de este dispositivo."
          }
        }
      }
    },
