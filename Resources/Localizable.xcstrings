    "Accesso al calendario non concesso. Puoi abilitarlo nelle Impostazioni.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso al calendario non concesso. Puoi abilitarlo nelle Impostazioni."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar access wasn’t granted. You can enable it in Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au calendrier n’a pas été autorisé. Vous pouvez l’activer dans les réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kalenderzugriff wurde nicht erlaubt. Du kannst ihn in den Einstellungen aktivieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha concedido acceso al calendario. Puedes activarlo en Ajustes."
          }
        }
      }
    },
    "Accesso non riuscito. Riprova senza modificare il tuo archivio locale.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso non riuscito. Riprova senza modificare il tuo archivio locale."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in failed. Try again; your local archive is unchanged."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion a échoué. Réessayez ; votre archive locale est conservée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldung fehlgeschlagen. Versuche es erneut; dein lokales Archiv bleibt erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar sesión. Reintenta; tu archivo local se conserva."
          }
        }
      }
    },
