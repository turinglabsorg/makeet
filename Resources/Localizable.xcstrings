    "Esportazione non riuscita. Riprova quando il servizio è raggiungibile.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esportazione non riuscita. Riprova quando il servizio è raggiungibile."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export failed. Retry when the service is reachable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’exportation a échoué. Réessayez quand le service est accessible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Export fehlgeschlagen. Versuche es erneut, wenn der Dienst erreichbar ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La exportación falló. Reinténtalo cuando el servicio esté disponible."
          }
        }
      }
    },
    "Lo storico è conservato. Puoi ripristinarla dall’archivio nelle impostazioni.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo storico è conservato. Puoi ripristinarla dall’archivio nelle impostazioni."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History is preserved. Restore this habit from the archive in settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique est conservé. Restaurez cette habitude depuis les archives dans les réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf bleibt erhalten. Stelle die Gewohnheit im Archiv in den Einstellungen wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial se conserva. Restaura este hábito desde el archivo en los ajustes."
          }
        }
      }
    },
    "Questi dati sono stati eliminati su un altro dispositivo. Conferma la rimozione anche qui.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi dati sono stati eliminati su un altro dispositivo. Conferma la rimozione anche qui."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This data was deleted on another device. Confirm its removal here too."
          }
        },
        "fr": {
