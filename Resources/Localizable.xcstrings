    "Nessuna abitudine era ancora iniziata. Puoi cambiare la data di inizio modificando l’abitudine.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna abitudine era ancora iniziata. Puoi cambiare la data di inizio modificando l’abitudine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No habits had started yet. You can change the start date by editing a habit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune habitude n’avait encore commencé. Vous pouvez changer la date de début en modifiant l’habitude."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es hatte noch keine Gewohnheit begonnen. Du kannst das Startdatum beim Bearbeiten einer Gewohnheit ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no había empezado ningún hábito. Puedes cambiar la fecha de inicio editando un hábito."
          }
        }
      }
    },
    "Non hai abitudini in programma. Nel Calendario puoi vedere e correggere tutti i tuoi progressi.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai abitudini in programma. Nel Calendario puoi vedere e correggere tutti i tuoi progressi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No habits are scheduled. View and adjust all your progress in Calendar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune habitude n’est prévue. Retrouvez et corrigez tous vos progrès dans Calendrier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es sind keine Gewohnheiten geplant. In Kalender kannst du alle Fortschritte ansehen und korrigieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tienes hábitos programados. En Calendario puedes ver y corregir todos tus progresos."
          }
        }
      }
    },
