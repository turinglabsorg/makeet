    "I giorni di riposo non interrompono le serie e non contano come obiettivi mancati.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giorni di riposo non interrompono le serie e non contano come obiettivi mancati."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest days do not break streaks or count as missed goals."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours de repos ne rompent pas les séries et ne comptent pas comme des objectifs manqués."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhetage unterbrechen keine Serien und zählen nicht als verfehlte Ziele."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días de descanso no interrumpen las rachas ni cuentan como objetivos incumplidos."
          }
        }
      }
    },
    "I progressi sono cambiati. Riapri il giorno per usare i valori aggiornati.": {
      "localizations": {
        "it": {
