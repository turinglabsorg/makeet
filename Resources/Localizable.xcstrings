          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Daten wurden auf einem anderen Gerät gelöscht. Bestätige die Entfernung auch hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos datos se eliminaron en otro dispositivo. Confirma su eliminación también aquí."
