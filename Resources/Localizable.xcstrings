          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can adjust past days from the habit’s start date onward."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez corriger les jours passés à partir de la date de début de l’habitude."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst vergangene Tage ab dem Startdatum der Gewohnheit korrigieren."
          }
        },
